# ==========================================
# Environment Variables Configuration
# ==========================================
# Copy this file to .env and update with your values
# For cloud deployment, set these in your platform dashboard

# Application
APP_ENV=production
APP_NAME="Yangtze University Canteen Management System"
APP_URL=https://your-domain.com
BASE_URL=https://your-domain.com/

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=canteen_management
DB_USER=root
DB_PASS=

# Alternative: DATABASE_URL (used by Railway, Heroku)
# DATABASE_URL=mysql://user:password@host:port/database

# MySQL Alternative Names (some platforms use these)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=canteen_management
MYSQL_USER=root
MYSQL_PASSWORD=

# Session Configuration
SESSION_TIMEOUT=1800

# Security
CSRF_TOKEN_SECRET=change-this-to-random-string

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=/uploads/

# Email Configuration (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com

# Timezone
TIMEZONE=Asia/Shanghai
